{
  "name": "olj-alerts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "db:push": "drizzle-kit push",
    "backfill:pay": "tsx src/scripts/backfill-pay.ts",
    "check:pay": "tsx src/pay.ts",
    "check:overview": "tsx src/overview.ts",
    "check:signals": "tsx src/signals.ts",
    "check:employer": "tsx src/employer-check.ts",
    "check:utils": "tsx src/utils.ts",
    "check:alert": "tsx src/alert.ts",
    "check:banner": "tsx src/banner.ts",
    "preview:banner": "tsx src/scripts/preview-banner.ts",
    "test": "npm run check:pay && npm run check:signals && npm run check:employer && npm run check:overview && npm run check:utils && npm run check:alert && npm run check:banner",
    "eval:overview": "tsx src/scripts/eval-overview.ts",
    "eval:real": "tsx src/scripts/eval-real.ts",
    "reanalyze:overview": "tsx src/scripts/reanalyze-overview.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "grammy": "^1.32.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
